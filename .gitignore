# Models / large generated assets
models/
!apps/desktop/src-tauri/models/
!apps/desktop/src-tauri/models/catalog.json
*.onnx
*.gguf
*.bin
*.safetensors

# Bundled sidecar payloads (whisper.cpp aligner runtime + ggml-tiny weights)
# are staged by scripts/stage-aligner-sidecar.sh: generated, hash-pinned in
# SIDECAR.yaml, never committed (repo rule: no model binaries in git).
apps/desktop/sidecar/
# Throwaway payloads written by scripts/test-stage-aligner-sidecar.sh: the
# staging script refuses a payload root that git could commit.
apps/desktop/sidecar-test/

# Private audio / research fixtures unless explicitly permissioned
private-recordings/
*.wav.private
*.mp3.private

# Pack listening audio is regenerated at build time (ADR-0016). The committed
# artifact is languages/*/media/manifest.jsonl (hash + synthesizer identity per
# asset); the .wav bytes themselves never enter history.
languages/*/media/*.wav

# JS/Rust/Python build artifacts
node_modules/
target/
dist/
build/
.venv/
__pycache__/
*.pyc

# App local data
*.sqlite
*.sqlite3
local-data/

# Secrets
.env
.env.*
!.env.example

# OS/editor
.DS_Store
.idea/
.vscode/
tests/performance/results/

# Scratch / external review data (not for commit)
tmp/
