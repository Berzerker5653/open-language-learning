# Models / large generated assets
models/
!apps/desktop/src-tauri/models/
!apps/desktop/src-tauri/models/catalog.json
*.onnx
*.gguf
*.bin
*.safetensors

# Bundled sidecar payloads (whisper.cpp aligner runtime + ggml-tiny weights)
# are staged by scripts/stage-aligner-sidecar.sh: generated, hash-pinned in
# SIDECAR.yaml, never committed (repo rule: no model binaries in git).
apps/desktop/sidecar/
# Throwaway payloads written by scripts/test-stage-aligner-sidecar.sh: the
# staging script refuses a payload root that git could commit.
apps/desktop/sidecar-test/

# Private audio / research fixtures unless explicitly permissioned
private-recordings/
*.wav.private
*.mp3.private

# Pack listening audio is regenerated at build time (ADR-0016). The committed
# artifact is languages/*/media/manifest.jsonl (hash + synthesizer identity per
# asset); the .wav bytes themselves never enter history.
languages/*/media/*.wav

# ADR-0032 (Proposed): 18 journey assets were authored after the pinned 0.4.0
# archives were published, so no published archive can supply their bytes and
# `scripts/fetch-pack-audio.sh` cannot restore them. They are tracked by name,
# not by widening the rule above; delete this block and the files when the
# owner republishes both packs at 0.4.1 (owner decision O-01b).
!languages/ja-JP/media/ja.sent.office-notice-time.wav
!languages/ja-JP/media/ja.sent.office-room-reserve.wav
!languages/ja-JP/media/ja.sent.office-thanks-notice.wav
!languages/ja-JP/media/ja.sent.office-question-email.wav
!languages/ja-JP/media/ja.sent.film-long-interesting.wav
!languages/ja-JP/media/ja.sent.film-friend-recommended.wav
!languages/ja-JP/media/ja.sent.film-teacher-points.wav
!languages/ja-JP/media/ja.sent.film-recommend-friend.wav
!languages/ru-RU/media/ru.sent.a2.j1.wav
!languages/ru-RU/media/ru.sent.a2.j2.wav
!languages/ru-RU/media/ru.sent.a2.j3.wav
!languages/ru-RU/media/ru.sent.b1.j1.wav
!languages/ru-RU/media/ru.sent.b1.j2.wav
!languages/ru-RU/media/ru.sent.b1.j3.wav
!languages/ru-RU/media/ru.sent.b2.j1.wav
!languages/ru-RU/media/ru.sent.b2.j2.wav
!languages/ru-RU/media/ru.sent.b2.j3.wav
!languages/ru-RU/media/ru.sent.b2.j4.wav

# ASR round-trip QA + bake-repair convergence scratch (scripts/qa-asr.py,
# scripts/bake-repair-loop.sh): per-run logs/JSONL, never history.
qa-r*.log
qa-r*.jsonl
qa-*.log
qa-*.jsonl
repair-r*.log

