import { StressText } from \"./stress\";
import { Ruby } from \"./ruby\";
import { useKanaIME } from \"./kana-ime\";
import type { ImeCandidate } from \"./ime-candidates\";
import { LatinText, PackText, usePackTextAttrs } from \"@openlang/ui\";
import type { DictationResult } from \"./dictation\";

export interface PracticeTaskView {
  item_id: string;
  /// Null for listening tasks: the transcript must stay hidden for the
  /// evidence to count (MASTERY_POLICY disqualifying_for).
  surface?: string | null;
  /// Reading aid for non-Japanese packs only; Japanese packs use the
  /// reader fields below (READ-001).
  reading?: string | null;
  /// Kana reading above kanji; hidden once reading mastery fades it.
  furigana?: string | null;
  romaji?: string | null;
  faded_by_mastery?: boolean;
  choices: string[];
  /// K-12: typed-answer runner (cloze/dictation); choices are empty.
  typed?: boolean;
  /// K-42: review posture of the underlying pack record; display-only,
  /// never affects grading or scheduling.
  status?: string;
  /// K-44: phrase slot structure (display-only). Exactly one slot is
  /// the target; never affects grading or scheduling.
  slots?: {
    text: string;
    alternatives: string[];
    label?: string | null;
    target: boolean;
  }[];
  /// RU-MODALITY-PRACTICE-001: the scoring posture the runner that built
  /// this task reports. Absent = scored practice, exactly as before;
  /// \"guided\" = formative only — no submit, no correct/incorrect, no
  /// score (mirrors `PracticeTask::mode` in lib.rs, which skips the key
  /// when the runner is scored).
  mode?: \"guided\";
}

export interface PracticeRunnerProps {
  task: PracticeTaskView;
  /// When the runner IS the whole route (inline practice), this names
  /// the route as its single h1. Embedded runners (placement, kanji)
  /// omit it — their route section already carries the h1.
  routeHeading?: string;
  graded: boolean;
  correct: boolean;
  correctChoice: string;
  /// Audio provenance for listening tasks; null when no audio exists.
  audioSource?: \"licensed-recording\" | \"model-output\" | null;
  audioError?: string | null;
  /// True once the learner revealed reading scaffolds this attempt.
  revealed?: boolean;
  /// Task question; defaults to the word-meaning prompt. Script
  /// instruction passes its own (the direction is decided natively).
  heading?: string;
  onChoose(index: number): void;
  onNext(): void;
  /// Session label for the graded follow-up action; the default is the
  /// single-activity wording.
  nextLabel?: string;
  onPlayAudio?(): void;
  /// F-07: true while the listening clip is playing; drives the button's
  /// pressed state and a spoken \"playing\" status.
  playing?: boolean;
  /// Issue #2 phase 1: the learner's in-app kana keyboard choice; when on,
  /// the answer field converts romaji to kana without any system IME.
  kanaInput?: boolean;
  /// IN-APP-IME-001 phase 2: pack-lexicon candidate lookup (undefined when
  /// the active pack's declared input methods rule the method out).
  imeCandidates?: (kana: string) => Promise<ImeCandidate[]>;
  onReveal?(): void;
  /// K-41: highlight U+0301-stressed vowels in readings (display-only).
  stress?: boolean;
  /// Typed runner only: the draft answer and grading trigger.
  draft?: string;
  onDraft?(value: string): void;
  onCheck?(): void;
  /// Guided-speaking card only: the formative speak-along affordances.
  /// The recording belongs to this card; its free-ASR check result is
  /// shown as an abstention notice, never as a verdict.
  speakCheck?: DictationResult | null;
  recording?: boolean;
  hasAttempt?: boolean;
  onRecord?(): void;
  onStop?(): void;
  onPlayAttempt?(): void;
}

/**
 * RU-MODALITY-PRACTICE-001: the formative guided-speaking card. The
 * engine already decided the posture (`mode: \"guided\"` on the task);
 * this view mirrors it — the declared sentence, its reading, and
 * speak-along affordances only. There is no submit control because a
 * speaking attempt is refused natively (`practice_submit` answers
 * \"speaking attempts are never scored\"), and nothing here renders a
 * score, a correct/incorrect verdict, or a matched badge
 * (ADR-0017 decision 1).
 */
function speakCheckNotice(result: DictationResult): string {
  if (result.abstain_reason === \"pack-locale-unknown\")
    return \"The spoken check abstained: this pack declares no target locale, so the app has no speech-recognition language to compare your recording against. Nothing was judged, and nothing here is scored.\";
  if (result.abstain_reason)
    return `The spoken check abstained (${result.abstain_reason}). Nothing was judged, and nothing here is scored.`;
  if (result.heard)
    return `The check heard: “${result.heard}”. Compare it with the sentence yourself — nothing here is scored.`;
  return \"The spoken check came back with nothing to report. Nothing here is scored.\";
}

export function PracticeRunner(p: PracticeRunnerProps) {
  const packAttrs = usePackTextAttrs();
  const kanaIme = useKanaIME({
    enabled: p.kanaInput === true,
    value: p.draft ?? \"\",
    onDraft: (v) => p.onDraft?.(v),
    candidates: p.imeCandidates,
  });
  if (p.task.mode === \"guided\") {
    return (
      <section aria-label=\"Practice\" className=\"practice-guided\">
        {p.routeHeading ? <h1>{p.routeHeading}</h1> : null}
        <h2>Say the sentence aloud</h2>
        <p className=\"prompt\" {...packAttrs}>
          <Ruby surface={p.task.surface ?? \"\"} furigana={p.task.furigana} />
        </p>
        {p.task.reading ? (
          <p {...packAttrs}>
            <small>{p.stress ? <StressText text={p.task.reading} /> : p.task.reading}</small>
          </p>
        ) : null}
        {p.audioError ? (
          <p className=\"notice\">{p.audioError}</p>
        ) : (
          <div className=\"btn-row\">
            <button
              type=\"button\"
              className=\"btn btn--primary\"
              aria-label=\"Play the model audio\"
              onClick={() => p.onPlayAudio?.()}
            >
              ▶ Play the sentence
            </button>
            {p.audioSource === \"model-output\" && (
              <small className=\"notice\">synthesized voice (model output)</small>
            )}
          </div>
        )}
        <div role=\"group\" aria-label=\"Recording\" className=\"btn-row\">
          {p.recording ? (
            <button type=\"button\" className=\"btn btn--primary\" onClick={() => p.onStop?.()}>
              Stop
            </button>
          ) : (
            <button type=\"button\" className=\"btn btn--primary\" onClick={() => p.onRecord?.()}>
              Record yourself
            </button>
          )}
          <button
            type=\"button\"
            className=\"btn btn--quiet\"
            onClick={() => p.onPlayAttempt?.()}
            disabled={!p.hasAttempt}
          >
            Hear your recording
          </button>
        </div>
        <div aria-live=\"polite\">
          {p.speakCheck ? (
            <p data-testid=\"speak-check\" className=\"notice\">
              {speakCheckNotice(p.speakCheck)}
            </p>
          ) : null}
        </div>
        <p>
          <small data-testid=\"guided-mode\">
            Speaking practice is formative: it is not scored, and it never counts toward mastery.
          </small>
        </p>
      </section>
    );
  }

  return (
    <section aria-label=\"Practice\">
      {p.routeHeading ? <h1>{p.routeHeading}</h1> : null}
      {p.task.surface ? (
        <>
          <h2>{p.heading ?? \"What does this mean?\"}</h2>
          <p className=\"prompt\" {...packAttrs}>
            <Ruby surface={p.task.surface} furigana={p.task.furigana} />
          </p>
          {p.task.slots && p.task.slots.length > 0 ? (
            <div className=\"meta\" role=\"group\" aria-label=\"Phrase structure\">
              {p.task.slots.map((slot, i) => (
                <p key={i}>
                  <PackText tag=\"span\" className={slot.target ? \"badge\" : undefined}>
                    {slot.text}
                  </PackText>
                  {slot.target ? \" — the part to change\" : \"\"}
                  {slot.label ? ` (${slot.label})` : \"\"}
                  {slot.alternatives.length > 0 ? (
                    <small>
                      can also be: <PackText>{slot.alternatives.join(\", \")}</PackText>
                    </small>
                  ) : null}
                </p>
              ))}
            </div>
          ) : null}
          {p.task.reading && (
            <p {...packAttrs}>
              <small>{p.stress ? <StressText text={p.task.reading} /> : p.task.reading}</small>
            </p>
          )}
          {p.task.romaji && (
            <p>
              <small>
                <LatinText>{p.task.romaji}</LatinText>
              </small>
            </p>
          )}
          {!p.graded && !p.revealed && p.onReveal && (
            <div className=\"btn-row\">
              <button type=\"button\" className=\"btn btn--quiet\" onClick={() => p.onReveal?.()}>
                Show reading
              </button>
            </div>
          )}
        </>
      ) : (
        <>
          <h2>What did you hear?</h2>
          {p.audioError ? (
            <p className=\"notice\">{p.audioError}</p>
          ) : (
            <div className=\"btn-row\">
              <button
                type=\"button\"
                className=\"btn btn--primary\"
                aria-label=\"Play the audio\"
                aria-pressed={p.playing === true}
                onClick={() => p.onPlayAudio?.()}
              >
                ▶ Play
              </button>
              <small className=\"notice\" role=\"status\">
                {p.playing ? \"playing\" : \"\"}
              </small>
              {p.audioSource === \"model-output\" && (
                <small className=\"notice\">synthesized voice (model output)</small>
              )}
            </div>
          )}
        </>
      )}
      {p.task.typed ? (
        <div className=\"field\">
          <label htmlFor=\"practice-answer\">Type your answer</label>
          <input
            id=\"practice-answer\"
            type=\"text\"
            value={p.draft ?? \"\"}
            disabled={p.graded}
            onKeyDown={kanaIme.onKeyDown}
            onChange={(e) => {
              kanaIme.noteExternalEdit();
              p.onDraft?.(e.target.value);
            }}
          />
          <div className=\"btn-row\">
            <button
              type=\"button\"
              className=\"btn btn--primary\"
              disabled={p.graded || (p.draft ?? \"\").trim() === \"\"}
              onClick={() => p.onCheck?.()}
            >
              Check
            </button>
          </div>
        </div>
      ) : (
        <div role=\"group\" aria-label=\"Choices\" className=\"btn-row\">
          {p.task.choices.map((choice, i) => (
            <button
              key={choice}
              type=\"button\"
              className={
                p.graded && !p.correct && choice === p.correctChoice
                  ? \"btn btn--quiet choice--correct\"
                  : \"btn btn--quiet\"
              }
              disabled={p.graded}
              onClick={() => p.onChoose(i)}
            >
              <PackText>{choice}</PackText>
            </button>
          ))}
        </div>
      )}
      <p
        role=\"status\"
        aria-live=\"polite\"
        className={
          p.graded ? (p.correct ? \"verdict verdict--correct\" : \"verdict verdict--retry\") : undefined
        }
      >
        {p.graded
          ? p.correct
            ? \"Correct\"
            : // LETTER-DRILL-TEXT-001: the verdict points at the right
              // choice, it never states it — a hint that spells the
              // answer trains nothing.
              \"Not quite — the highlighted choice is the right one.\"
          : \"\"}
      </p>
      {p.graded && (
        <div className=\"btn-row\">
          <button type=\"button\" className=\"btn btn--primary\" onClick={p.onNext}>
            {p.nextLabel ?? \"Back to plan\"}
          </button>
        </div>
      )}
    </section>
  );
}
