  async function setGrammarLabelsSetting(on: boolean) {
    if (!inv || !profileId) return;
    setSettingsError(null);
    try {
      setDisplay(
        (await inv(\"set_display_settings\", {
          profileId,
          stressMode: display?.stress_mode ?? \"auto\",
          grammarLabels: on,
        })) as DisplaySettingsView,
