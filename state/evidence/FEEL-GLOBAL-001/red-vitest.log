+       applyPlan(home.plan);
+       setNextGoal(home.next_goal);
+       setFirstRunSteps((await inv("first_run_steps", { profileId })) as FirstRunStep[]);
+       setPathNodes((await inv("unit_path", { profileId })) as UnitPathNode[]);
