+   display: grid;
+   grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
+   gap: 0.75rem;
+   margin: 0.75rem 0 1rem;
+ }
+
+ .profile-card {
+   display: flex;
+   flex-direction: column;
+   align-items: flex-start;
+   gap: 0.35rem;
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-bottom: 1px solid var(--line-strong);
+   border-radius: var(--radius);
+   box-shadow: var(--shadow);
+   padding: 1rem;
+ }
+
+ .profile-avatar {
+   display: inline-flex;
+   align-items: center;
+   justify-content: center;
+   width: 2.5rem;
+   height: 2.5rem;
+   border-radius: 50%;
+   background: var(--accent-soft);
+   color: var(--accent-ink);
+   font-weight: 700;
+   font-size: 0.9375rem;
+   letter-spacing: 0.02em;
+ }
+
+ .profile-name {
+   font-size: 1.05rem;
+ }
+
+ .profile-card .btn-row {
+   margin-top: 0.35rem;
+ }
+
+ /* K-41: stressed-vowel highlight (data-driven; color supplementary,
+    the combining mark itself stays visible) */
+ .stress {
+   color: var(--accent-ink);
+   font-weight: 700;
+   text-decoration: underline;
+   text-decoration-thickness: 2px;
+   text-underline-offset: 3px;
+ }
+
+ /* READING-CLUTTER-001: the reader shows no interlinear chips — the pack's
+    label sidecar is internal notation; grammar rides the word card in human
+    form. (The old .il-token/.il-label micro-rail rules were removed with
+    the inline chips.) */
+
+ /* CONTENT-CONFIRM-001 (READING-CLUTTER-001 shape): one quiet
+    learner-agreement control under the whole story — never a button inside
+    the prose. */
+ .story-confirm {
+   display: flex;
+   flex-wrap: wrap;
+   align-items: center;
+   gap: 0.25rem 0.75rem;
+   color: var(--ink-faint);
+   font-size: 0.875rem;
+ }
+
+ .story-confirm .story-confirm-toggle {
+   font-size: 0.875rem;
+   padding: 0.375rem 0.75rem;
+ }
+
+ /* ------------------------------------------------------------- stepper */
+ .stepper {
+   counter-reset: step;
+   list-style: none;
+   display: flex;
+   flex-wrap: wrap;
+   gap: 0.375rem 1.5rem;
+   padding: 0;
+   margin: 0 0 1.25rem;
+ }
+
+ .stepper li {
+   counter-increment: step;
+   display: inline-flex;
+   align-items: center;
+   gap: 0.5rem;
+   font-size: 0.875rem;
+   color: var(--ink-faint);
+ }
+
+ .stepper li::before {
+   content: counter(step);
+   display: grid;
+   place-items: center;
+   width: 1.5rem;
+   height: 1.5rem;
+   border: 1px solid currentColor;
+   border-radius: 50%;
+   font-size: 0.8125rem;
+   font-weight: 600;
+ }
+
+ .stepper li[aria-current="step"] {
+   color: var(--accent-ink);
+   font-weight: 700;
+ }
+
+ /* ---------------------------------------------------------- plan lists */
+ .plan-summary {
+   color: var(--ink-soft);
+   font-weight: 600;
+ }
+
+ .plan-list {
+   list-style: none;
+   display: grid;
+   gap: 0.5rem;
+   padding: 0;
+   margin: 0.75rem 0 1rem;
+ }
+
+ .plan-list > li {
+   display: flex;
+   align-items: baseline;
+   flex-wrap: wrap;
+   gap: 0.25rem 0.75rem;
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--radius);
+   padding: 0.75rem 1rem;
+ }
+
+ .plan-reason {
+   font-weight: 600;
+ }
+
+ .meta {
+   color: var(--ink-faint);
+   font-size: 0.875rem;
+ }
+
+ .plan-item {
+   display: flex;
+   align-items: baseline;
+   flex-wrap: wrap;
+   gap: 0.25rem 0.75rem;
+   width: 100%;
+   text-align: left;
+   background: none;
+   border: none;
+   color: inherit;
+   font: inherit;
+   padding: 0;
+   cursor: pointer;
+ }
+
+ .plan-surface {
+   font-size: 1.125rem;
+ }
+
+ .plan-gloss {
+   color: var(--ink-faint);
+ }
+
+ /* environments */
+ .place-list {
+   list-style: none;
+   display: grid;
+   gap: 0.5rem;
+   padding: 0;
+   margin: 0.75rem 0;
+ }
+
+ .place-list > li {
+   display: flex;
+   align-items: baseline;
+   flex-wrap: wrap;
+   gap: 0.25rem 0.75rem;
+   padding: 0.75rem 1rem;
+   border: 1px solid var(--line);
+   border-radius: var(--radius);
+   background: var(--surface);
+ }
+
+ .place-list > li[data-unlocked="no"] {
+   background: var(--bg);
+ }
+
+ /* ---------------------------------------------------------------- table */
+ .table-wrap {
+   overflow-x: auto;
+   border: 1px solid var(--line);
+   border-radius: var(--radius);
+   background: var(--surface);
+ }
+
+ table {
+   border-collapse: collapse;
+   width: 100%;
+   font-size: 0.9375rem;
+ }
+
+ th,
+ td {
+   text-align: left;
+   padding: 0.625rem 1rem;
+   border-bottom: 1px solid var(--line);
+ }
+
+ thead th {
+   font-size: 0.75rem;
+   font-weight: 700;
+   letter-spacing: 0.06em;
+   text-transform: uppercase;
+   color: var(--ink-faint);
+   background: var(--bg);
+ }
+
+ tbody tr:last-child th,
+ tbody tr:last-child td {
+   border-bottom: 0;
+ }
+
+ td:last-child,
+ th:last-child {
+   text-align: right;
+ }
+
+ /* ------------------------------------------------------- practice views */
+ .prompt {
+   font-size: 1.125rem;
+   max-width: 60ch;
+ }
+
+ .target-word {
+   font-size: 1.35rem;
+   font-weight: 700;
+ }
+
+ .feedback {
+   list-style: none;
+   display: grid;
+   gap: 0.5rem;
+   padding: 0;
+   margin: 0.75rem 0;
+ }
+
+ .feedback > li {
+   border: 1px solid var(--line);
+   border-left: 4px solid var(--ink-faint);
+   border-radius: var(--radius-sm);
+   background: var(--surface);
+   padding: 0.75rem 1rem;
+   max-width: 65ch;
+ }
+
+ .feedback > li[data-band="possible-issue"] {
+   border-left-color: var(--warn);
+   background: var(--warn-soft);
+ }
+
+ .feedback > li[data-band="close"],
+ .feedback > li[data-band="match"] {
+   border-left-color: var(--ok);
+   background: var(--ok-soft);
+ }
+
+ /* graded answer feedback: text + glyph, never color alone */
+ .verdict {
+   font-weight: 700;
+   margin: 0.75rem 0;
+ }
+
+ .verdict--correct {
+   color: var(--ok);
+ }
+
+ /* LETTER-DRILL-TEXT-001: after a miss the runner POINTS at the right
+    choice (complaint 4g: a hint that states the answer trains nothing);
+    the correct button carries this marker. */
+ .choice--correct {
+   border-color: var(--ok);
+   box-shadow: 0 0 0 2px var(--ok);
+ }
+
+ .verdict--correct::before {
+   content: "\2713\00a0"; /* check mark */
+ }
+
+ .verdict--retry {
+   color: var(--warn);
+ }
+
+ .verdict--retry::before {
+   content: "\21bb\00a0"; /* open, non-punitive retry marker */
+ }
+
+ /* pitch contour comparison */
+ .contour {
+   display: block;
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--radius-sm);
+   margin: 0.5rem 0;
+   max-width: 100%;
+ }
+
+ .contour--reference {
+   stroke: var(--ink-faint);
+ }
+
+ .contour--attempt {
+   stroke: var(--accent);
+ }
+
+ /* -------------------------------------------------- language management */
+ .pack-list {
+   list-style: none;
+   display: grid;
+   gap: 0.5rem;
+   padding: 0;
+   margin: 0.75rem 0 1rem;
+ }
+
+ .pack-list > li {
+   display: flex;
+   align-items: center;
+   flex-wrap: wrap;
+   gap: 0.375rem 0.75rem;
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: var(--radius);
+   padding: 0.875rem 1rem;
+ }
+
+ .pack-list > li[data-active="yes"] {
+   border-color: var(--accent);
+ }
+
+ .meta-list {
+   list-style: none;
+   display: flex;
+   flex-wrap: wrap;
+   gap: 0.125rem 1rem;
+   padding: 0;
+   margin: 0.25rem 0 0;
+   width: 100%;
+ }
+
+ .meta-list li {
+   color: var(--ink-faint);
+   font-size: 0.8125rem;
+ }
+
+ /* --------------------------------------------------------- responsive */
+ /* MOBILE-UX-001 (owner standard 2026-11-21: "look and run good on phones"):
+    a real phone layout tier at 44rem — comfortable type, a compact one-row
+    route bar, generous touch targets, and lists that stack. The wide-screen
+    measure token above (LETTER-DRILL-TEXT-001) is reused, not duplicated:
+    every rule here works off --content-max and the existing tokens.
+    44rem = 704px covers the 390/412px card viewports and the landscape
+    gap; the 24rem (384px) tier catches the small end of the phone range. */
+ @media (max-width: 44rem) {
+   /* Typography at phone distance: body keeps the 1rem base (comfortable
+      at 30cm), headings scale down so they stop eating the narrow column. */
+   h1 {
+     font-size: 1.5rem;
+   }
+
+   h2 {
+     font-size: 1.1875rem;
+     margin-top: 1.5rem;
+   }
+
+   /* Shell collapses to a compact bar: brand line, then the route tabs as
+      a full-width strip. Five tabs at this padding measure ~350px, so the
+      strip stays one row at 390/412px instead of scrolling or stacking
+      twice. */
+   .shell-bar {
+     padding: 0.5rem 1rem 0;
+     min-height: 0;
+     row-gap: 0;
+   }
+
+   .brand {
+     margin-right: 0;
+     width: 100%;
+     font-size: 1rem;
+   }
+
+   .routes {
+     width: 100%;
+     /* Measured at 390px: five tabs' intrinsic text (with "Progress") is
+        ~360px and overflowed a nowrap row into a clipped, internally
+        scrolling strip. Wrapping keeps every route visible with zero
+        sideways movement; at 412px the row stays single-line. */
+     flex-wrap: wrap;
+     row-gap: 0.25rem;
+     padding-bottom: 0.25rem;
+   }
+
+   .tab {
+     flex: 1 1 auto;
+     justify-content: center;
+     /* 2.75rem = 44px exactly: the WCAG 2.2 AA target size, kept at the
+        narrow padding, not dropped with it */
+     min-height: 2.75rem;
+     padding: 0.5rem 0.5rem;
+     font-size: 0.875rem;
+   }
+
+   .page {
+     padding: 1.25rem 1rem 3rem;
+   }
+
+   .card {
+     padding: 1.125rem 1rem;
+   }
+
+   .btn {
+     flex: 1 1 auto;
+   }
+
+   .btn-row .btn {
+     min-width: 9rem;
+   }
+
+   /* Touch targets (card §2): drill options and reader controls ride .btn
+      (min-height 2.75rem — verified by the tap-target audit in
+      state/evidence/MOBILE-UX-001/). The small controls that are NOT .btn
+      join the 44px floor here. */
+   .seg-btn {
+     min-height: 2.75rem;
+     padding-inline: 0.875rem;
+   }
+
+   details.prose-note > summary {
+     min-height: 2.75rem;
+     display: flex;
+     align-items: center;
+   }
+
+   .input-mode-bubble__button {
+     min-height: 2.75rem;
+     padding: 0.5rem 1rem;
+   }
+
+   /* Session chrome stacks: progress bar above the meta line so the
+      nowrap estimate never squeezes against the bar edge. */
+   .session-chrome {
+     flex-wrap: wrap;
+     row-gap: 0.25rem;
+   }
+
+   /* Reader at phone distance: the story text is the point of the screen,
+      so it gets a comfortable display size and looser leading. Word taps
+      ride inline buttons — the leading makes each tap row ~40px tall; the
+      audit records inline text as the one honest exception to the 44px
+      floor (word-level accuracy needs it, and the word card is the
+      fallback surface). */
+   .reader-paragraph {
+     font-size: 1.1875rem;
+     line-height: 2.1;
+     margin-bottom: 1rem;
+   }
+
+   .word-card .word-headword {
+     font-size: 1.5rem;
+   }
+
+   /* WORDCARD-OFFSCREEN-001: the word card is an inline-flow element
+      appended after the whole reading paragraph, so at phone height it
+      rendered ~640px BELOW the fold (measured y=1486 on an 844px viewport)
+      and the tap looked dead. At phone width it becomes a fixed bottom
+      sheet: always inside the viewport, scrollable inside itself, and the
+      Close row sticks to its bottom edge so it never hides behind long
+      content. Wide viewports keep the inline card (no rule there). */
+   .word-card {
+     position: fixed;
+     left: 0;
+     right: 0;
+     bottom: 0;
+     z-index: 45;
+     margin: 0;
+     border-inline: 0;
+     border-block-end: 0;
+     border-end-start-radius: 0;
+     border-end-end-radius: 0;
+     max-height: 70svh;
+     overflow-y: auto;
+     overscroll-behavior: contain;
+   }
+
+   .word-card .btn-row {
+     position: sticky;
+     bottom: 0;
+     background: var(--surface);
+     padding-block: 0.5rem;
+     margin-bottom: 0;
+   }
+
+   /* Fixed-width instruments (activity calendar SVG, contours) live in
+      their own scroll container instead of widening the document. */
+   .memory-calendar {
+     overflow-x: auto;
+   }
+
+   /* Settings at phone width (measured by the harness audit, 390px):
+      a long speech-model <select> was 479px intrinsic and pushed the
+      DOCUMENT to 512px horizontal scroll — selects ride the column. */
+   select {
+     width: 100%;
+     max-width: 100%;
+     min-height: 2.75rem;
+     font-size: 1rem;
+   }
+
+   /* The destructive-delete confirmation checkbox (settings.tsx) renders at
+      the UA default 13x13 — unusable with a thumb; the row carries the
+      label, the box itself joins the 44px floor. */
+   input[type="checkbox"] {
+     width: 2.75rem;
+     height: 2.75rem;
+   }
+ }
+
+ @media (max-width: 24rem) {
+   .tab {
+     font-size: 0.8125rem;
+     padding-inline: 0.375rem;
+   }
+ }
+
+ /* ------------------------------------------- input-mode bubble (IME-TOGGLE-UX-001) */
+ /* Pinned to the app chrome so it rides every in-app route; the caller only
+  * renders it while the active pack declares an in-app keyboard. */
+ .input-mode-bubble {
+   position: fixed;
+   right: 1rem;
+   bottom: 1rem;
+   z-index: 40;
+ }
+
+ .input-mode-bubble__button {
+   display: inline-flex;
+   align-items: center;
+   gap: 0.5rem;
+   padding: 0.5rem 0.875rem;
+   border: 1px solid var(--line);
+   border-radius: 999px;
+   background: var(--surface);
+   color: var(--ink);
+   font: inherit;
+   font-size: 0.875rem;
+   cursor: pointer;
+   box-shadow: 0 2px 8px rgb(0 0 0 / 12%);
+ }
+
+ .input-mode-bubble__button[aria-pressed="true"] {
+   border-color: var(--accent);
+   color: var(--accent);
+ }
+
+ .input-mode-bubble__button:hover {
+   border-color: var(--accent);
+ }
+
+ @media (prefers-color-scheme: dark) {
+   .input-mode-bubble__button {
+     box-shadow: 0 2px 8px rgb(0 0 0 / 40%);
+   }
+ }
+
+ /* ------------------------------------------- WORD-TIMING-001 karaoke text */
+ /* Pack surfaces with word timings render each timed word as a pressable
+    token; the token whose clip span covers the playback clock carries
+    `word--active`. Untimed surfaces never get these classes at all. */
+ .word {
+   border: 0;
+   padding: 0;
+   margin: 0;
+   background: none;
+   color: inherit;
+   font: inherit;
+   cursor: pointer;
+ }
+
+ .word:focus-visible {
+   outline: 2px solid var(--accent);
+   outline-offset: 2px;
+ }
+
+ .word--active {
+   background: var(--accent-soft);
+   color: var(--accent-ink);
+   border-radius: var(--radius-sm);
+ }
+
+ /* ------------------------------------------------------ reduced motion */
+ @media (prefers-reduced-motion: reduce) {
+   *,
+   *::before,
+   *::after {
+     animation-duration: 0.01ms !important;
+     animation-iteration-count: 1 !important;
+     transition-duration: 0.01ms !important;
+     scroll-behavior: auto !important;
+   }
+ }
+
+ /* ------------------------------------------------ SESSION-CHROME-001 */
+ /* In-session chrome (visual-ui-audit U3): a thin bar plus n-of-N and a
+    remaining-time estimate, mounted above every activity route while a
+    session runs. Accent is reserved for progress semantics only. */
+ .session-chrome {
+   display: flex;
+   align-items: center;
+   gap: 0.75rem;
+   margin: 0 0 1rem;
+ }
+
+ .session-bar {
+   flex: 1 1 auto;
+   height: 0.5rem;
+   background: var(--surface-sunk);
+   border: 1px solid var(--line);
+   border-radius: 999px;
+   overflow: hidden;
+ }
+
+ .session-bar-fill {
+   display: block;
+   height: 100%;
+   background: var(--accent);
+ }
+
+ .session-chrome-meta {
+   margin: 0;
+   color: var(--ink-soft);
+   font-size: 0.875rem;
+   white-space: nowrap;
+ }
+
+ /* SESSION-FLOW-COPY-001: the inter-activity bridge — a calm, announced
+    transition, not a gate: centered, quiet, and carrying its own pause
+    control so the auto-advance never outruns the learner. */
+ .session-bridge {
+   display: flex;
+   flex-direction: column;
+   align-items: center;
+   gap: 0.9rem;
+   padding: 2.2rem 1rem;
+   text-align: center;
+ }
+ .session-bridge-label {
+   margin: 0;
+   font-size: 1.25rem;
+   color: var(--ink);
+ }
+ .notice-line {
+   display: block;
+ }
+
+ /* U6: dues expressed as a time budget, and the predicted interval
+    printed inside a review grade button. */
+ .plan-due-budget {
+   margin: 0.1rem 0 0.5rem;
+   color: var(--ink-soft);
+ }
+
+ .grade-preview {
+   color: var(--ink-soft);
+   font-weight: 400;
+ }
+
+ /* U3: the graded/formative distinction as a badge on hub mode cards. */
+ .mode-grade-badge {
+   display: inline-block;
+   padding: 0.1rem 0.5rem;
+   border: 1px solid var(--line-strong);
+   border-radius: 999px;
+   font-size: 0.75rem;
+   font-weight: 600;
+   color: var(--ink-soft);
+   background: var(--surface-sunk);
+ }
+
+ .mode-grade-badge--graded {
+   background: var(--accent-soft);
+   border-color: var(--accent);
+   color: var(--accent-ink);
+ }
+
+ /* PROGRESS-STATS-001 (visual-ui-audit U7/U14): progress instruments.
+    Dependency-free SVG; contrast comes from strokes and lightness steps,
+    never from hue alone. */
+ .dim-progress {
+   display: inline-block;
+   vertical-align: middle;
+   margin-inline-start: 0.5rem;
+ }
+
+ .dim-progress-track {
+   fill: var(--surface-sunk);
+   stroke: var(--line);
+ }
+
+ .dim-progress-fill {
+   fill: var(--accent);
+ }
+
+ .memory-stats-facts {
+   list-style: none;
+   padding: 0;
+   margin: 0.5rem 0;
+ }
+
+ .memory-retention ul {
+   list-style: none;
+   padding: 0;
+ }
+
+ .memory-calendar svg {
+   display: block;
+ }
+
+ .memory-cal-cell {
+   stroke: var(--line);
+ }
+
+ .memory-cal-cell--0 {
+   fill: var(--surface-sunk);
+ }
+
+ .memory-cal-cell--1 {
+   fill: var(--accent);
+   fill-opacity: 0.3;
+ }
+
+ .memory-cal-cell--2 {
+   fill: var(--accent);
+   fill-opacity: 0.55;
+ }
+
+ .memory-cal-cell--3 {
+   fill: var(--accent);
+   fill-opacity: 0.8;
+ }
+
+ .memory-cal-cell--4 {
+   fill: var(--accent);
+   fill-opacity: 1;
+ }
+
+ /* PATH-VIEW-001 + PATH-VISUAL-001: the Today tab's unit path rendered as
+    a JOURNEY, not a list (owner dogfood 2026-11-22: "I wanted it to look
+    and feel like the other apps"). A winding vertical track: circular
+    node rings that sway along a wave, dashed connectors between them,
+    section banners between node groups. States: locked = dim ring + lock,
+    ready = open ring, in-progress = the ring arc FILLED to the honest
+    proven-ref fraction, done = filled + check, review-due = a re-lit
+    ring. Mobile-first: every control and node meets the 44px touch floor
+    (the ring is 3rem = 48px). */
+ .unit-path {
+   display: grid;
+   gap: 0.75rem;
+   margin-top: 1.25rem;
+ }
+
+ .path-section {
+   border: none;
+   border-radius: 0;
+   background: none;
+ }
+
+ /* Section breaks ride wide banners: friendly name big, CEFR subtitle
+    small, the proven-done count honest (never visits or encounters). */
+ .path-section-toggle {
+   display: grid;
+   grid-template-columns: 1fr auto;
+   grid-template-areas:
+     "name count"
+     "cefr count";
+   align-items: center;
+   gap: 0.1rem 0.75rem;
+   width: 100%;
+   min-height: 3.25rem;
+   padding: 0.65rem 0.9rem;
+   background: var(--surface);
+   border: 1px solid var(--line);
+   border-radius: 0.9rem;
+   color: inherit;
+   font: inherit;
+   text-align: left;
+   cursor: pointer;
+   /* PATH-FEEL-MOTION-001: the banner is a real control, so it takes a
+      press: 120ms down-shift per the FEEL-TARGETS button legend. */
+   transition:
+     transform 120ms ease-out,
+     background-color 120ms ease-out,
+     border-color 120ms ease-out;
+ }
+
+ .path-section-toggle:active,
+ .path-next-up:active {
+   transform: translateY(2px);
+   background-color: var(--surface-sunk);
+   border-color: var(--line-strong);
+ }
+
+ .path-section-name {
+   grid-area: name;
+   font-weight: 700;
+   font-size: 1.15rem;
+ }
+
