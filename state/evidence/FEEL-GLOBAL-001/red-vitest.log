+         installable: boolean;
+         size_bytes: number;
+         role: "recognition" | "synthesis";
+       }>;
+       setSpeechComponents(
+         all.map((m) => ({
+           id: m.id,
+           name: speechLabel(m),
+           installed: m.installed,
+           installable: m.installable,
+           size_bytes: m.size_bytes,
+           role: m.role,
