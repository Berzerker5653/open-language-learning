/* ---------------------------------------------------------------- tokens */
:root {
  color-scheme: light;

  /* warm neutrals */
  --bg: #f5f1e9;
  --surface: #fffdf9;
  --surface-sunk: #ece5d8;
  --ink: #241f18;
  --ink-soft: #5c544a;
  --ink-faint: #756c5d; /* AA: >=4.5 on both bg and surface (K-33 audit) */
  --line: #e2dacc;
  --line-strong: #c9beab;

  /* single accent */
  --accent: #14615e;
  --accent-ink: #0e4a47;
  --accent-soft: #e2eeeb;

  /* semantic feedback only */
  --ok: #2e7d46;
  --ok-ink: #276b3c;
  --ok-soft: #e8f0e6;
  --warn: #8a6116;
  --warn-soft: #f6ecd7;
  --err: #b23a2e;
  --err-soft: #f7e5e1;

  --font-sans:
    system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", \"Noto Sans JP\", \"Hiragino Sans\",
    \"Yu Gothic UI\", \"Meiryo\", sans-serif;
  --font-display:
    ui-serif, \"Iowan Old Style\", \"Palatino Linotype\", Georgia, \"Noto Serif JP\",
    \"Hiragino Mincho ProN\", \"Yu Mincho\", serif;
  --font-mono:
    ui-monospace, \"SF Mono\", \"Cascadia Mono\", \"Noto Sans Mono\", Menlo, Consolas, monospace;

  --radius: 8px;
  --radius-sm: 6px;
  --shadow: 0 1px 2px rgb(36 31 24 / 0.05);
  /* UI-HYGIENE-001 (visual-ui-audit U1): one content-width token shared
     by the header bar, the page column, and the card/list containers
     inside it, so their left edges align at every breakpoint. Readable
     measure stays per-element (p at 70ch etc.). */
  --content-max: 46rem;
}

/* LETTER-DRILL-TEXT-001 (d): on wide panels — the owner's 4K desktop and
   the dogfood VM at 1920 — the 46rem measure is a narrow sliver with a
   huge dead gutter beside it, which read as the column \"hanging right\".
   One token bump at wide viewports widens the measure and keeps the
   header/column/card left edges aligned; margin-inline: auto keeps the
   column centered at every width. */
@media (min-width: 100rem) {
  :root {
    --content-max: 64rem;
  }
}

/* ------------------------------------------------------------------ base */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  -webkit-text-size-adjust: 100%;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.6;
}

h1,
h2,
h3 {
  font-family: var(--font-display);
  line-height: 1.25;
  margin: 0 0 0.5rem;
}

h1 {
  font-size: 1.75rem;
  font-weight: 600;
}

/* LESSON-TITLE-FIT-001: the lesson encounter title (\"Printed Cyrillic: А а,
   О о, М м, Т т\") must always FIT the narrow card column — never a glyph
   hanging past its edge. Wrapping is already the default (no nowrap rides
   this heading), so this rule fixes the FIT of the wrap: balance keeps the
   lines even instead of orphaning one glyph on its own line, and
   break-word is the safety net for any long unbreakable token at the small
   end of the phone range. The harness gate in scripts/encounter-capture.mjs
   measures the h1's own line rects, so a regression to clipping fails
   machine-checked, not just on vision. */
.lesson h1 {
  text-wrap: balance;
  overflow-wrap: break-word;
}

h2 {
  font-size: 1.3rem;
  font-weight: 600;
  margin-top: 2rem;
}

h3 {
  font-size: 1.05rem;
  font-weight: 600;
}

p {
  margin: 0 0 0.75rem;
  max-width: 70ch;
}

small {
  font-size: 0.875rem;
  color: var(--ink-soft);
}

a {
  color: var(--accent);
  text-decoration-thickness: 1px;
  text-underline-offset: 2px;
}

code {
  font-family: var(--font-mono);
  font-size: 0.85em;
  background: var(--surface-sunk);
  border-radius: 4px;
  padding: 0.1em 0.35em;
  overflow-wrap: anywhere;
}

:lang(ja) {
  line-height: 1.7;
}

:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

/* ----------------------------------------------------------------- shell */
a[href=\"#main\"] {
  position: absolute;
  left: -100vw;
  top: 0;
  z-index: 20;
  background: var(--surface);
  border: 1px solid var(--accent);
  border-radius: var(--radius-sm);
  padding: 0.5rem 1rem;
}

a[href=\"#main\"]:focus {
  left: 0.75rem;
  top: 0.75rem;
}

header {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--surface);
  border-bottom: 1px solid var(--line);
}

.shell-bar {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
  max-width: var(--content-max);
  margin-inline: auto;
  padding: 0.5rem 1.25rem;
  min-height: 3.5rem;
}

.brand {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 600;
  letter-spacing: 0.01em;
  margin-right: auto;
}

header nav[aria-label=\"Primary\"] ul {
  list-style: none;
  display: flex;
  gap: 1rem;
  margin: 0;
  padding: 0;
}

header nav[aria-label=\"Primary\"] a {
  color: var(--ink-soft);
  text-decoration: none;
  font-size: 0.9375rem;
}

header nav[aria-label=\"Primary\"] a:hover {
  color: var(--accent);
  text-decoration: underline;
}

/* route tabs (interactive route switcher) */
.routes {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  overflow-x: auto;
}

.tab {
  appearance: none;
  background: none;
  border: 0;
  border-bottom: 2px solid transparent;
  color: var(--ink-soft);
  font: inherit;
  font-size: 0.9375rem;
  font-weight: 600;
  padding: 0.625rem 0.75rem;
  min-height: 2.75rem;
  cursor: pointer;
  white-space: nowrap;
}

.tab:hover {
  color: var(--ink);
}

.tab[aria-current=\"page\"] {
  color: var(--accent-ink);
  border-bottom-color: var(--accent);
}

main {
  display: block;
}

.page {
  max-width: var(--content-max);
  margin-inline: auto;
  padding: 1.75rem 1.25rem 4rem;
}

/* --------------------------------------------------------------- buttons */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  min-height: 2.75rem;
  padding: 0.5rem 1.125rem;
  border-radius: var(--radius-sm);
  border: 1px solid var(--line-strong);
  background: var(--surface);
  color: var(--ink);
  font: inherit;
  font-size: 0.9375rem;
  font-weight: 600;
  cursor: pointer;
  text-align: center;
}

.btn:hover:not(:disabled) {
  background: var(--surface-sunk);
  border-color: var(--ink-faint);
}

.btn--primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
}

.btn--primary:hover:not(:disabled) {
  background: var(--accent-ink);
  border-color: var(--accent-ink);
}

.btn--quiet {
  background: var(--surface);
  border-color: var(--line-strong);
  color: var(--ink);
}

.btn--quiet:hover:not(:disabled) {
  background: var(--surface-sunk);
}

.btn:disabled {
  opacity: 0.45;
  color: var(--ink-soft);
  border-color: var(--line);
  background: var(--surface-sunk);
  cursor: not-allowed;
}

.btn-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin: 0.75rem 0 1rem;
}

/* segmented control (time budget) */
.seg {
  display: inline-flex;
  flex-wrap: wrap;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius);
  background: var(--surface);
  overflow: hidden;
}

.seg-btn {
  appearance: none;
  background: none;
  border: 0;
  border-left: 1px solid var(--line);
  font: inherit;
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--ink-soft);
  padding: 0.5rem 1rem;
  min-height: 2.75rem;
  cursor: pointer;
}

.seg-btn:first-child {
  border-left: 0;
}

.seg-btn:hover {
  background: var(--surface-sunk);
}

.seg-btn[aria-pressed=\"true\"] {
  /* UI-HYGIENE-001 (U1): selected segment reads at a glance — solid
     fill, not a tint; text colour is supplementary, aria-pressed is
     the semantic state. */
  background: var(--accent);
  color: #ffffff;
  font-weight: 700;
}

/* ---------------------------------------------------------------- forms */
.field {
  margin: 0.75rem 0 1rem;
  max-width: 24rem;
}

.field > label {
  display: block;
  font-weight: 600;
  font-size: 0.9375rem;
  margin-bottom: 0.25rem;
}

input[type=\"text\"] {
  width: 100%;
  min-height: 2.75rem;
  padding: 0.5rem 0.75rem;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-sm);
  background: var(--surface);
  color: var(--ink);
  font: inherit;
}

input[type=\"text\"]:focus-visible {
  border-color: var(--accent);
}

input[type=\"radio\"] {
  width: 1.15rem;
  height: 1.15rem;
  accent-color: var(--accent);
  margin: 0;
}

input[type=\"file\"] {
  font: inherit;
  color: var(--ink-soft);
  max-width: 100%;
}

fieldset {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  padding: 0.75rem 1rem 1rem;
  margin: 0 0 1rem;
}

legend {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--ink-soft);
  padding: 0 0.375rem;
}

.radio-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem 0.75rem;
  padding: 0.75rem 0.5rem;
  border-bottom: 1px solid var(--line);
}

.radio-row:last-of-type {
  border-bottom: 0;
}

.radio-row label {
  display: inline-flex;
  align-items: center;
  gap: 0.625rem;
  flex: 1 1 14rem;
  cursor: pointer;
}

/* ------------------------------------------------------------- surfaces */
.card {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 1.5rem 1.5rem 1.25rem;
  margin: 1rem 0;
}

/* SETTINGS-TEXT-COLLAPSE-001: folded prose behind a native details/summary
   disclosure. The collapsed summary reads exactly like the `small` prose it
   stands in for, so folding changes length, not style; the expanded body is
   the same `small` text unchanged. Keyboard focus rides the global
   :focus-visible rule; no JS, no custom widget. */
details.prose-note {
  margin: 0 0 0.75rem;
  max-width: 70ch;
}

details.prose-note > summary {
  font-size: 0.875rem;
  color: var(--ink-soft);
  cursor: pointer;
}

details.prose-note[open] > summary {
  margin-bottom: 0.4rem;
}

details.prose-note > p {
  margin-bottom: 0;
}

.empty {
  border: 1px dashed var(--line-strong);
  border-radius: var(--radius);
  background: var(--surface);
  color: var(--ink-soft);
  padding: 1rem 1.25rem;
  margin: 1rem 0;
}

.notice {
  background: var(--warn-soft);
  border: 1px solid var(--warn);
  border-left-width: 4px;
  border-radius: var(--radius-sm);
  padding: 0.75rem 1rem;
  margin: 0.75rem 0 1rem;
  max-width: none;
}

.alert {
  background: var(--err-soft);
  border: 1px solid var(--err);
  border-left-width: 4px;
  border-radius: var(--radius-sm);
  padding: 0.75rem 1rem;
  margin: 0.75rem 0 1rem;
  max-width: none;
}

/* badges — always carry text; color is supplementary */
.badge {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding: 0.1rem 0.5rem;
  border-radius: 4px;
  border: 1px solid var(--line-strong);
  color: var(--ink-soft);
  background: var(--surface-sunk);
  vertical-align: baseline;
}

.badge--open {
  color: var(--ok-ink);
  border-color: var(--ok);
  background: var(--ok-soft);
}

.badge--active {
  color: var(--accent-ink);
  border-color: var(--accent);
  background: var(--accent-soft);
}

/* UI-HYGIENE-001 (visual-ui-audit U2): the AI-content honesty line is a
   small monospace badge (NuanceDeck idiom), not greeting prose; the
   tooltip carries the full policy. */
.badge--mono {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.pack-posture-badge {
  vertical-align: middle;
  cursor: help;
}

/* UI-HYGIENE-001 (visual-ui-audit U13): the profile chooser renders one
   aligned card per real profile — initials avatar, pack line, last
   studied, one-line state. Cards align on the shared content width. */
.profile-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
  gap: 0.75rem;
  margin: 0.75rem 0 1rem;
}

.profile-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0.35rem;
  background: var(--surface);
  border: 1px solid var(--line);
  border-bottom: 1px solid var(--line-strong);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 1rem;
}

.profile-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent-ink);
  font-weight: 700;
  font-size: 0.9375rem;
  letter-spacing: 0.02em;
}

.profile-name {
  font-size: 1.05rem;
}

.profile-card .btn-row {
  margin-top: 0.35rem;
}

/* K-41: stressed-vowel highlight (data-driven; color supplementary,
   the combining mark itself stays visible) */
.stress {
  color: var(--accent-ink);
  font-weight: 700;
  text-decoration: underline;
  text-decoration-thickness: 2px;
  text-underline-offset: 3px;
}

/* READING-CLUTTER-001: the reader shows no interlinear chips — the pack's
   label sidecar is internal notation; grammar rides the word card in human
   form. (The old .il-token/.il-label micro-rail rules were removed with
   the inline chips.) */

/* CONTENT-CONFIRM-001 (READING-CLUTTER-001 shape): one quiet
   learner-agreement control under the whole story — never a button inside
   the prose. */
.story-confirm {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.25rem 0.75rem;
  color: var(--ink-faint);
  font-size: 0.875rem;
}

.story-confirm .story-confirm-toggle {
  font-size: 0.875rem;
  padding: 0.375rem 0.75rem;
}

/* ------------------------------------------------------------- stepper */
.stepper {
  counter-reset: step;
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.375rem 1.5rem;
  padding: 0;
  margin: 0 0 1.25rem;
}

.stepper li {
  counter-increment: step;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: var(--ink-faint);
}

.stepper li::before {
  content: counter(step);
  display: grid;
  place-items: center;
  width: 1.5rem;
  height: 1.5rem;
  border: 1px solid currentColor;
  border-radius: 50%;
  font-size: 0.8125rem;
  font-weight: 600;
}

.stepper li[aria-current=\"step\"] {
  color: var(--accent-ink);
  font-weight: 700;
}

/* ---------------------------------------------------------- plan lists */
.plan-summary {
  color: var(--ink-soft);
  font-weight: 600;
}

.plan-list {
  list-style: none;
  display: grid;
  gap: 0.5rem;
  padding: 0;
  margin: 0.75rem 0 1rem;
}

.plan-list > li {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.25rem 0.75rem;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 0.75rem 1rem;
}

.plan-reason {
  font-weight: 600;
}

.meta {
  color: var(--ink-faint);
  font-size: 0.875rem;
}

.plan-item {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.25rem 0.75rem;
  width: 100%;
  text-align: left;
  background: none;
  border: none;
  color: inherit;
  font: inherit;
  padding: 0;
  cursor: pointer;
}

.plan-surface {
  font-size: 1.125rem;
}

.plan-gloss {
  color: var(--ink-faint);
}

/* environments */
.place-list {
  list-style: none;
  display: grid;
  gap: 0.5rem;
  padding: 0;
  margin: 0.75rem 0;
}

.place-list > li {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.25rem 0.75rem;
  padding: 0.75rem 1rem;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}

.place-list > li[data-unlocked=\"no\"] {
  background: var(--bg);
}

/* ---------------------------------------------------------------- table */
.table-wrap {
  overflow-x: auto;
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
}

table {
  border-collapse: collapse;
  width: 100%;
  font-size: 0.9375rem;
}

th,
td {
  text-align: left;
  padding: 0.625rem 1rem;
  border-bottom: 1px solid var(--line);
}

thead th {
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ink-faint);
  background: var(--bg);
}

tbody tr:last-child th,
tbody tr:last-child td {
  border-bottom: 0;
}

td:last-child,
th:last-child {
  text-align: right;
}

/* ------------------------------------------------------- practice views */
.prompt {
  font-size: 1.125rem;
  max-width: 60ch;
}

.target-word {
  font-size: 1.35rem;
  font-weight: 700;
}

.feedback {
  list-style: none;
  display: grid;
  gap: 0.5rem;
  padding: 0;
  margin: 0.75rem 0;
}

.feedback > li {
  border: 1px solid var(--line);
  border-left: 4px solid var(--ink-faint);
  border-radius: var(--radius-sm);
  background: var(--surface);
  padding: 0.75rem 1rem;
  max-width: 65ch;
}

.feedback > li[data-band=\"possible-issue\"] {
  border-left-color: var(--warn);
  background: var(--warn-soft);
}

.feedback > li[data-band=\"close\"],
.feedback > li[data-band=\"match\"] {
  border-left-color: var(--ok);
  background: var(--ok-soft);
}

/* graded answer feedback: text + glyph, never color alone */
.verdict {
  font-weight: 700;
  margin: 0.75rem 0;
}

.verdict--correct {
  color: var(--ok);
}

/* LETTER-DRILL-TEXT-001: after a miss the runner POINTS at the right
   choice (complaint 4g: a hint that states the answer trains nothing);
   the correct button carries this marker. */
.choice--correct {
  border-color: var(--ok);
  box-shadow: 0 0 0 2px var(--ok);
}

.verdict--correct::before {
  content: \"\\2713\\00a0\"; /* check mark */
}

.verdict--retry {
  color: var(--warn);
}

.verdict--retry::before {
  content: \"\\21bb\\00a0\"; /* open, non-punitive retry marker */
}

/* pitch contour comparison */
.contour {
  display: block;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius-sm);
  margin: 0.5rem 0;
  max-width: 100%;
}

.contour--reference {
  stroke: var(--ink-faint);
}

.contour--attempt {
  stroke: var(--accent);
}

/* -------------------------------------------------- language management */
.pack-list {
  list-style: none;
  display: grid;
  gap: 0.5rem;
  padding: 0;
  margin: 0.75rem 0 1rem;
}

.pack-list > li {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.375rem 0.75rem;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 0.875rem 1rem;
}

.pack-list > li[data-active=\"yes\"] {
  border-color: var(--accent);
}

.meta-list {
  list-style: none;
  display: flex;
  flex-wrap: wrap;
  gap: 0.125rem 1rem;
  padding: 0;
  margin: 0.25rem 0 0;
  width: 100%;
}

.meta-list li {
  color: var(--ink-faint);
  font-size: 0.8125rem;
}

/* --------------------------------------------------------- responsive */
/* MOBILE-UX-001 (owner standard 2026-11-21: \"look and run good on phones\"):
   a real phone layout tier at 44rem — comfortable type, a compact one-row
   route bar, generous touch targets, and lists that stack. The wide-screen
   measure token above (LETTER-DRILL-TEXT-001) is reused, not duplicated:
   every rule here works off --content-max and the existing tokens.
   44rem = 704px covers the 390/412px card viewports and the landscape
   gap; the 24rem (384px) tier catches the small end of the phone range. */
@media (max-width: 44rem) {
  /* Typography at phone distance: body keeps the 1rem base (comfortable
     at 30cm), headings scale down so they stop eating the narrow column. */
  h1 {
    font-size: 1.5rem;
  }

  h2 {
    font-size: 1.1875rem;
    margin-top: 1.5rem;
  }

  /* Shell collapses to a compact bar: brand line, then the route tabs as
     a full-width strip. Five tabs at this padding measure ~350px, so the
     strip stays one row at 390/412px instead of scrolling or stacking
     twice. */
  .shell-bar {
    padding: 0.5rem 1rem 0;
    min-height: 0;
    row-gap: 0;
  }

  .brand {
    margin-right: 0;
    width: 100%;
    font-size: 1rem;
  }

  .routes {
    width: 100%;
    /* Measured at 390px: five tabs' intrinsic text (with \"Progress\") is
       ~360px and overflowed a nowrap row into a clipped, internally
       scrolling strip. Wrapping keeps every route visible with zero
       sideways movement; at 412px the row stays single-line. */
    flex-wrap: wrap;
    row-gap: 0.25rem;
    padding-bottom: 0.25rem;
  }

  .tab {
    flex: 1 1 auto;
    justify-content: center;
    /* 2.75rem = 44px exactly: the WCAG 2.2 AA target size, kept at the
       narrow padding, not dropped with it */
    min-height: 2.75rem;
    padding: 0.5rem 0.5rem;
    font-size: 0.875rem;
  }

  .page {
    padding: 1.25rem 1rem 3rem;
  }

  .card {
    padding: 1.125rem 1rem;
  }

  .btn {
    flex: 1 1 auto;
  }

  .btn-row .btn {
    min-width: 9rem;
  }

  /* Touch targets (card §2): drill options and reader controls ride .btn
     (min-height 2.75rem — verified by the tap-target audit in
     state/evidence/MOBILE-UX-001/). The small controls that are NOT .btn
     join the 44px floor here. */
  .seg-btn {
    min-height: 2.75rem;
    padding-inline: 0.875rem;
  }

  details.prose-note > summary {
    min-height: 2.75rem;
    display: flex;
    align-items: center;
  }

  .input-mode-bubble__button {
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
  }

  /* Session chrome stacks: progress bar above the meta line so the
     nowrap estimate never squeezes against the bar edge. */
  .session-chrome {
    flex-wrap: wrap;
    row-gap: 0.25rem;
  }

  /* Reader at phone distance: the story text is the point of the screen,
     so it gets a comfortable display size and looser leading. Word taps
     ride inline buttons — the leading makes each tap row ~40px tall; the
     audit records inline text as the one honest exception to the 44px
     floor (word-level accuracy needs it, and the word card is the
     fallback surface). */
  .reader-paragraph {
    font-size: 1.1875rem;
    line-height: 2.1;
    margin-bottom: 1rem;
  }

  .word-card .word-headword {
    font-size: 1.5rem;
  }

  /* WORDCARD-OFFSCREEN-001: the word card is an inline-flow element
     appended after the whole reading paragraph, so at phone height it
     rendered ~640px BELOW the fold (measured y=1486 on an 844px viewport)
     and the tap looked dead. At phone width it becomes a fixed bottom
     sheet: always inside the viewport, scrollable inside itself, and the
     Close row sticks to its bottom edge so it never hides behind long
     content. Wide viewports keep the inline card (no rule there). */
  .word-card {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 45;
    margin: 0;
    border-inline: 0;
    border-block-end: 0;
    border-end-start-radius: 0;
    border-end-end-radius: 0;
    max-height: 70svh;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .word-card .btn-row {
    position: sticky;
    bottom: 0;
    background: var(--surface);
    padding-block: 0.5rem;
    margin-bottom: 0;
  }

  /* Fixed-width instruments (activity calendar SVG, contours) live in
     their own scroll container instead of widening the document. */
  .memory-calendar {
    overflow-x: auto;
  }

  /* Settings at phone width (measured by the harness audit, 390px):
     a long speech-model <select> was 479px intrinsic and pushed the
     DOCUMENT to 512px horizontal scroll — selects ride the column. */
  select {
    width: 100%;
    max-width: 100%;
    min-height: 2.75rem;
    font-size: 1rem;
  }

  /* The destructive-delete confirmation checkbox (settings.tsx) renders at
     the UA default 13x13 — unusable with a thumb; the row carries the
     label, the box itself joins the 44px floor. */
  input[type=\"checkbox\"] {
    width: 2.75rem;
    height: 2.75rem;
  }
}

@media (max-width: 24rem) {
  .tab {
    font-size: 0.8125rem;
    padding-inline: 0.375rem;
  }
}

/* ------------------------------------------- input-mode bubble (IME-TOGGLE-UX-001) */
/* Pinned to the app chrome so it rides every in-app route; the caller only
 * renders it while the active pack declares an in-app keyboard. */
.input-mode-bubble {
  position: fixed;
  right: 1rem;
  bottom: 1rem;
  z-index: 40;
}

.input-mode-bubble__button {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 0.875rem;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface);
  color: var(--ink);
  font: inherit;
  font-size: 0.875rem;
  cursor: pointer;
  box-shadow: 0 2px 8px rgb(0 0 0 / 12%);
}

.input-mode-bubble__button[aria-pressed=\"true\"] {
  border-color: var(--accent);
  color: var(--accent);
}

.input-mode-bubble__button:hover {
  border-color: var(--accent);
}

@media (prefers-color-scheme: dark) {
  .input-mode-bubble__button {
    box-shadow: 0 2px 8px rgb(0 0 0 / 40%);
  }
}

/* ------------------------------------------- WORD-TIMING-001 karaoke text */
/* Pack surfaces with word timings render each timed word as a pressable
   token; the token whose clip span covers the playback clock carries
   `word--active`. Untimed surfaces never get these classes at all. */
.word {
  border: 0;
  padding: 0;
  margin: 0;
  background: none;
  color: inherit;
  font: inherit;
  cursor: pointer;
}

.word:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.word--active {
  background: var(--accent-soft);
  color: var(--accent-ink);
  border-radius: var(--radius-sm);
}

/* ------------------------------------------------------ reduced motion */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* ------------------------------------------------ SESSION-CHROME-001 */
/* In-session chrome (visual-ui-audit U3): a thin bar plus n-of-N and a
   remaining-time estimate, mounted above every activity route while a
   session runs. Accent is reserved for progress semantics only. */
.session-chrome {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin: 0 0 1rem;
}

.session-bar {
  flex: 1 1 auto;
  height: 0.5rem;
  background: var(--surface-sunk);
  border: 1px solid var(--line);
  border-radius: 999px;
  overflow: hidden;
}

.session-bar-fill {
  display: block;
  height: 100%;
  background: var(--accent);
}

.session-chrome-meta {
  margin: 0;
  color: var(--ink-soft);
  font-size: 0.875rem;
  white-space: nowrap;
}

/* SESSION-FLOW-COPY-001: the inter-activity bridge — a calm, announced
   transition, not a gate: centered, quiet, and carrying its own pause
   control so the auto-advance never outruns the learner. */
.session-bridge {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.9rem;
  padding: 2.2rem 1rem;
  text-align: center;
}
.session-bridge-label {
  margin: 0;
  font-size: 1.25rem;
  color: var(--ink);
}
.notice-line {
  display: block;
}

/* U6: dues expressed as a time budget, and the predicted interval
   printed inside a review grade button. */
.plan-due-budget {
  margin: 0.1rem 0 0.5rem;
  color: var(--ink-soft);
}

.grade-preview {
  color: var(--ink-soft);
  font-weight: 400;
}

/* U3: the graded/formative distinction as a badge on hub mode cards. */
.mode-grade-badge {
  display: inline-block;
  padding: 0.1rem 0.5rem;
  border: 1px solid var(--line-strong);
  border-radius: 999px;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--ink-soft);
  background: var(--surface-sunk);
}

.mode-grade-badge--graded {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent-ink);
}

/* PROGRESS-STATS-001 (visual-ui-audit U7/U14): progress instruments.
   Dependency-free SVG; contrast comes from strokes and lightness steps,
   never from hue alone. */
.dim-progress {
  display: inline-block;
  vertical-align: middle;
  margin-inline-start: 0.5rem;
}

.dim-progress-track {
  fill: var(--surface-sunk);
  stroke: var(--line);
}

.dim-progress-fill {
  fill: var(--accent);
}

.memory-stats-facts {
  list-style: none;
  padding: 0;
  margin: 0.5rem 0;
}

.memory-retention ul {
  list-style: none;
  padding: 0;
}

.memory-calendar svg {
  display: block;
}

.memory-cal-cell {
  stroke: var(--line);
}

.memory-cal-cell--0 {
  fill: var(--surface-sunk);
}

.memory-cal-cell--1 {
  fill: var(--accent);
  fill-opacity: 0.3;
}

.memory-cal-cell--2 {
  fill: var(--accent);
  fill-opacity: 0.55;
}

.memory-cal-cell--3 {
  fill: var(--accent);
  fill-opacity: 0.8;
}

.memory-cal-cell--4 {
  fill: var(--accent);
  fill-opacity: 1;
}

/* PATH-VIEW-001 + PATH-VISUAL-001: the Today tab's unit path rendered as
   a JOURNEY, not a list (owner dogfood 2026-11-22: \"I wanted it to look
   and feel like the other apps\"). A winding vertical track: circular
   node rings that sway along a wave, dashed connectors between them,
   section banners between node groups. States: locked = dim ring + lock,
   ready = open ring, in-progress = the ring arc FILLED to the honest
   proven-ref fraction, done = filled + check, review-due = a re-lit
   ring. Mobile-first: every control and node meets the 44px touch floor
   (the ring is 3rem = 48px). */
.unit-path {
  display: grid;
  gap: 0.75rem;
  margin-top: 1.25rem;
}

.path-section {
  border: none;
  border-radius: 0;
  background: none;
}

/* Section breaks ride wide banners: friendly name big, CEFR subtitle
   small, the proven-done count honest (never visits or encounters). */
.path-section-toggle {
  display: grid;
  grid-template-columns: 1fr auto;
  grid-template-areas:
    \"name count\"
    \"cefr count\";
  align-items: center;
  gap: 0.1rem 0.75rem;
  width: 100%;
  min-height: 3.25rem;
  padding: 0.65rem 0.9rem;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 0.9rem;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
  /* PATH-FEEL-MOTION-001: the banner is a real control, so it takes a
     press: 120ms down-shift per the FEEL-TARGETS button legend. */
  transition:
    transform 120ms ease-out,
    background-color 120ms ease-out,
    border-color 120ms ease-out;
}

.path-section-toggle:active,
.path-next-up:active {
  transform: translateY(2px);
  background-color: var(--surface-sunk);
  border-color: var(--line-strong);
}

.path-section-name {
  grid-area: name;
  font-weight: 700;
  font-size: 1.15rem;
}

.path-section-cefr {
  grid-area: cefr;
  color: var(--ink-faint);
  font-size: 0.85rem;
}

.path-section-count {
  grid-area: count;
  color: var(--ink-faint);
  font-size: 0.875rem;
  white-space: nowrap;
}

/* The winding column: nodes sway along `--path-sway` (computed in the
   component), and each ring carries dashed connector stubs angled to its
   neighbours. No border rail — the connectors ARE the road. */
.path-nodes {
  list-style: none;
  display: grid;
  gap: 0.75rem;
  margin: 0.5rem 0 0;
  padding: 0.25rem 0.5rem 0.5rem;
}

.path-node {
  display: grid;
  /* FIX-PATH-VISUAL-001-1: the ring column must CONTAIN the whole sway
     excursion. The wave reaches ±29px (34px amplitude rounded through
     sin), and the widest ring is the current node's 3.5rem dial — its
     right edge rides at columnCentre + 1.75rem + 29px. At the old 4rem
     column the ring crossed ~15px into the label at sway peaks (the
     owner's overlap complaint); 6.75rem keeps ≥3px clearance for even
     the current ring at every node index, and the ring never leaves
     the row box at the left extreme. The label column stays a
     straight, readable stack — the road winds, the text does not. */
  grid-template-columns: 6.75rem minmax(0, 1fr);
  align-items: center;
  gap: 0.4rem;
  min-height: 4.75rem;
  padding: 0.1rem 0.25rem;
  border-radius: 0.75rem;
}

.path-node-ring {
  position: relative;
  width: 3rem;
  height: 3rem;
  justify-self: center;
  display: grid;
  place-items: center;
  /* the wave: the ring sways along the deterministic path */
  transform: translateX(var(--path-sway, 0px));
  /* PATH-FEEL-MOTION-001: the press springs (Duolingo node pop), so a
     tap reads with a tiny overshoot on the way back, never a snap. */
  transition: transform 160ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.path-node-dial {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}

.path-node-track {
  fill: var(--surface-raised, var(--surface));
  stroke: var(--line-strong);
  stroke-width: 2.5;
  /* PATH-FEEL-MOTION-001: state colors (done/review/current) fade, not
     flip — 200ms ease-out per the FEEL-TARGETS motion language. */
  transition:
    fill 200ms ease-out,
    stroke 200ms ease-out;
}

.path-node-arc {
  fill: none;
  stroke: var(--accent);
  stroke-width: 3.5;
  stroke-linecap: round;
  /* PATH-FEEL-MOTION-001: RING FILL — when the engine's honest
     proven-ref fraction changes, the ring EASES to the new value
     (~300ms ease-out, the FEEL-TARGETS legend for progress fills). */
  transition:
    stroke-dasharray 300ms ease-out,
    stroke 200ms ease-out;
}

.path-node-marker {
  position: relative;
  z-index: 1;
  display: grid;
  place-items: center;
  font-size: 1.15rem;
  font-weight: 700;
}

/* PATH-NODE-TYPES-001: the kind pictogram in the ring center — a drawn
   SVG (never emoji) that inherits currentColor, so every existing state
   color rule keeps painting it like it paints the lock. */
.path-node-glyph {
  width: 1.05rem;
  height: 1.05rem;
  display: block;
}

/* PATH-NODE-TYPES-001 (a11y floor): the screen-reader kind word under
   every path node — the glyph must never be the only signal. */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip-path: inset(50%);
  white-space: nowrap;
  border: 0;
}

.path-node-lock {
  width: 1rem;
  height: 1rem;
  color: var(--ink-faint);
}

/* The road: dashed stubs angled from this ring toward the next one. */
.path-conn {
  position: absolute;
  left: 50%;
  width: 0;
  height: 2.9rem;
  border-left: 3px dashed var(--line-strong);
  opacity: 0.7;
}

.path-conn--down {
  top: calc(100% - 0.3rem);
  transform: translateX(-50%) rotate(var(--path-conn-down, 0deg));
  transform-origin: top center;
}

.path-conn--up {
  bottom: calc(100% - 0.3rem);
  transform: translateX(-50%) rotate(var(--path-conn-up, 0deg));
  transform-origin: bottom center;
}

.path-node-body {
  display: grid;
  gap: 0.15rem;
  min-width: 0;
}

.path-node-title {
  font-size: 1rem;
  line-height: 1.3;
}

/* States — engine-derived, never invented here. */
.path-node--locked {
  opacity: 0.55;
}

.path-node--locked .path-node-arc {
  stroke: transparent;
}

.path-node--done .path-node-track {
  fill: var(--ok);
  stroke: var(--ok);
}

.path-node--done .path-node-arc {
  stroke: var(--ok);
}

.path-node--done .path-node-marker {
  color: var(--surface, #fff);
}

.path-node--review-due .path-node-track {
  stroke: var(--warn);
}

.path-node--review-due .path-node-arc {
  stroke: var(--warn);
}

.path-node--review-due .path-node-ring {
  box-shadow: 0 0 0 4px var(--warn-soft);
  border-radius: 50%;
}

.path-node--review-due .path-node-marker {
  color: var(--warn);
}

.path-node--current .path-node-track {
  fill: var(--accent-soft);
  stroke: var(--accent);
  stroke-width: 3.5;
}

.path-node--current .path-node-ring {
  width: 3.5rem;
  height: 3.5rem;
  box-shadow: 0 0 0 5px var(--accent-soft);
  border-radius: 50%;
}

.path-node--current .path-node-marker {
  color: var(--accent);
}

/* PATH-VISUAL-001: started-but-unproven. The arc fills to the honest
   proven-ref fraction (0 when the learner only MET the material), and
   the row names the fraction — the honest answer to the dogfood
   contradiction \"pinned past a unit, yet 0/20 done\". */
.path-node--in-progress .path-node-track {
  stroke: var(--accent);
}

.path-node-pin {
  display: inline-block;
  color: var(--accent-ink, var(--accent));
  font-size: 0.85rem;
  font-weight: 600;
}

.path-node-progress {
  color: var(--ink-faint);
  font-size: 0.85rem;
}

.path-node-review {
  display: block;
  color: var(--warn);
  font-size: 0.85rem;
}

.path-node-hint {
  display: block;
  color: var(--ink-faint);
  font-size: 0.85rem;
}

/* UNIT-CAPSTONE-001: the checkpoint's own action — a real control on the
   node (44px floor, the same press family as .path-next-up), never a
   celebration (ADR-0002): one accent outline, honest words. */
.path-node-capstone-start {
  display: inline-flex;
  align-items: center;
  min-height: 2.75rem;
  margin-top: 0.5rem;
  padding: 0.6rem 1rem;
  background: var(--surface);
  border: 1px solid var(--accent);
  border-radius: 0.9rem;
  color: var(--accent-ink, var(--accent));
  font: inherit;
  font-size: 0.9rem;
  font-weight: 600;
  cursor: pointer;
  transition:
    transform 120ms ease-out,
    background-color 120ms ease-out;
}

.path-node-capstone-start:active {
  transform: scale(0.97);
}

/* UNIT-CAPSTONE-001: the one calm fact line after a review — status
   copy, not a reward banner (ADR-0002). */
.path-capstone-result {
  margin: 0.35rem 0 0.6rem;
  color: var(--ink);
  font-size: 0.92rem;
}

/* WARM-MOMENTS-001 (ADR-0002 amended): the unit-finish card. Quiet by
   design — one bordered surface, one accent edge, existing tokens only.
   No confetti palette, no animation theatrics; honest warmth lives in
   the copy, not in visual noise. */
.path-finish {
  margin: 0.5rem 0 0.8rem;
  padding: 0.8rem 1rem;
  background: var(--surface);
  border: 1px solid var(--line-strong);
  border-left: 3px solid var(--accent);
  border-radius: 10px;
}

.path-finish h3 {
  margin: 0 0 0.35rem;
  font-size: 1.02rem;
  color: var(--ink);
}

.path-finish p {
  margin: 0.2rem 0;
  font-size: 0.92rem;
}

/* WARM-MOMENTS-001: gentle facts on the Progress tab — a calm strip,
   never a scoreboard: no big numerals, no colors that grade you. */
.gentle-facts {
  margin: 0 0 1.1rem;
  padding: 0.75rem 1rem;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 10px;
}

.gentle-facts h2 {
  margin: 0 0 0.3rem;
  font-size: 0.98rem;
}

.gentle-facts p {
  margin: 0.15rem 0;
}

/* PATH-PIN-CONSISTENCY-001 (owner dogfood 2026-11-22 complaint 10): the
   next-up recommendation rides the path HEADER strip — the market
   pattern (position pin on the trail, action chip above it) — so the
   track keeps exactly ONE marker: \"where I am\". The chip is a real
   44px+ control; tapping it jumps the journey to the offered unit. */
.path-next-up {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 2.75rem;
  padding: 0.65rem 0.9rem;
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: 0.9rem;
  color: inherit;
  font: inherit;
  font-size: 0.95rem;
  text-align: left;
  cursor: pointer;
  /* PATH-FEEL-MOTION-001: same 120ms press family as the banners. */
  transition:
    transform 120ms ease-out,
    background-color 120ms ease-out,
    border-color 120ms ease-out;
}

/* PATH-FEEL-SCROLL-001 (Duolingo parity for the viewport): the floating
   \"jump to my spot\" control. The IntersectionObserver in home.tsx flips
   data-visible the moment the pinned node leaves the viewport; this CSS
   owns the announcement — opacity + visibility only (display:none would
   jump the layout), a soft rise-in, and the arrow rotated toward wherever
   my-spot lives. A fixed 52px circle (44px+ target rule), one accent,
   180ms ease-out: the calm-but-warm family, and motion-not-reward per
   ADR-0002 — it exists to save a scroll hunt, not to motivate. The
   global prefers-reduced-motion block flattens the fade; the control
   itself still appears (it is a navigation affordance, not animation). */
.path-jump-to-pin {
  position: fixed;
  right: 1rem;
  bottom: calc(1rem + env(safe-area-inset-bottom, 0px));
  z-index: 40;
  width: 3.25rem;
  height: 3.25rem;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--surface);
  border: 1px solid var(--line-strong);
  box-shadow: 0 2px 10px rgb(36 31 24 / 0.18);
  color: var(--accent);
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(10px) scale(0.92);
  transition:
    opacity 180ms ease-out,
    transform 180ms ease-out,
    visibility 0s linear 180ms;
}

.path-jump-to-pin[data-visible=\"true\"] {
  opacity: 1;
  visibility: visible;
  transform: none;
  transition:
    opacity 180ms ease-out,
    transform 180ms ease-out;
}

.path-jump-to-pin:active {
  transform: scale(0.92);
}

.path-jump-to-pin svg {
  width: 1.5rem;
  height: 1.5rem;
  transition: transform 180ms ease-out;
}

/* The arrow points WHERE my-spot is: up by default, flipped down when
   the pin sits below the current view. */
.path-jump-to-pin[data-dir=\"below\"] svg {
  transform: rotate(180deg);
}

/* ======================================================== PATH-FEEL-MOTION-001
   Motion pass on the journey (Duolingo parity for the ROAD — ADR-0002 safe:
   these are transitions and keyframes, never reward mechanics; the calm-but-
   warm posture from docs/design/PROGRESSION-UX-AUDIT-2026-11-22.md holds:
   120-300ms ease-out, 8-12px rises, one accent, no confetti — the durations
   match the FEEL-TARGETS-2026-11-22 motion legends). The card's acceptance
   gate (scripts/path-motion-capture.mjs) measures these as COMPUTED styles
   in the live app and re-measures them under emulated prefers-reduced-motion
   (the global reduce block near the end of this file flattens every duration
   below — nothing here may assume motion exists). */
@keyframes path-node-in {
  /* SECTION EXPAND: a band's nodes cascade in with a small rise + fade.
     The stagger rides --path-i (the node's row index, set by the
     component) and is CAPPED at 10 rows so even a huge band finishes
     under ~0.6s — the track reveals, it never drumrolls. */
  from {
    opacity: 0;
    transform: translateY(-0.6rem);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes path-nodes-close {
  /* SECTION COLLAPSE: the collapse is SEEN — the component keeps the
     list mounted for this exit, then unmounts. */
  from {
    opacity: 1;
    transform: none;
  }
  to {
    opacity: 0;
    transform: translateY(-0.5rem);
  }
}

@keyframes path-marker-pop {
  /* the done check pops in (the market's check-medallion feel), riding
     the same row stagger so a band's checks land in sequence, bottom-
     light: one small overshoot, no burst. */
  0% {
    opacity: 0;
    transform: scale(0.5);
  }
  70% {
    opacity: 1;
    transform: scale(1.08);
  }
  100% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes path-current-pulse {
  /* CURRENT-NODE PULSE: the frontier node breathes a soft accent halo
     (the market's glowing frontier ring) — slow, low-contrast, never
     blinking. The static ring shadow stays underneath so reduced
     motion still reads \"this one is now\". */
  0%,
  100% {
    opacity: 0.9;
    transform: scale(0.92);
  }
  50% {
    opacity: 0.35;
    transform: scale(1.18);
  }
}

.path-node {
  animation: path-node-in 240ms ease-out backwards;
  animation-delay: calc(min(var(--path-i, 0), 10) * 30ms);
}

.path-nodes--closing {
  animation: path-nodes-close 180ms ease-in forwards;
  pointer-events: none;
}

.path-node--done .path-node-marker {
  animation: path-marker-pop 260ms cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
  animation-delay: calc(min(var(--path-i, 0), 10) * 30ms + 120ms);
}

/* NODE TAP: the press lives on BOTH a JS pointer class (path-node--
   pressed, set by the component — touch browsers only honor :active on
   elements with handlers, and the serve mode runs on phones) and plain
   :active for mouse users. The ring squashes 10%; the spring transition
   on .path-node-ring brings it back with the Duolingo pop. */
.path-node--pressed .path-node-ring,
.path-node:active .path-node-ring {
  transform: translateX(var(--path-sway, 0px)) scale(0.9);
}

/* CURRENT-NODE PULSE host: a pseudo-element halo so the breathing never
   resizes or repaints the ring itself. Base style = the static halo
   (reduced-motion safe: killing the animation leaves it standing). */
.path-node--current .path-node-ring::after {
  content: \"\";
  position: absolute;
  inset: -2px;
  border-radius: 50%;
  box-shadow: 0 0 0 5px var(--accent-soft);
  animation: path-current-pulse 2.4s ease-in-out infinite;
}
