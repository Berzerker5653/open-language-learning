+   // one source (/api/capabilities), never in a local guess.
+   const [serveMicNamesAvailable, setServeMicNamesAvailable] = useState<boolean | null>(null);
+   useEffect(() => {
+     if (!inLtsServeMode()) return;
+     void fetchCapabilities().then((caps) => {
