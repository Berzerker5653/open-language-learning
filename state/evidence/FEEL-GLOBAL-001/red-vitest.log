+                     note: `scenario-transfer:${scen.scenario_id}:${opened ? "practice-opened" : done ? "done" : "no-visible-change"}`,
+                   });
+                 }
+               } else {
+                 // Branch-B packs (SCENARIO-TRANSFER-001): the section is
+                 // gone because nothing is required that cannot be done.
