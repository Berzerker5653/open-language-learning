{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlanguage.invalid/schemas/v0.2/common.schema.json",
  "title": "Shared definitions (pack schema 0.2)",
  "$defs": {
    "contentId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "packId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]+$"
    },
    "localeTag": {
      "type": "string",
      "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[xX](?:-[A-Za-z0-9]{1,8})+)$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "reviewStatus": {
      "enum": ["draft", "review-needed", "validated", "verified"]
    },
    "modality": {
      "enum": ["listening", "speaking", "reading", "writing", "interaction"]
    },
    "masteryDimension": {
      "enum": [
        "comprehension-listening",
        "comprehension-reading",
        "recall-meaning",
        "production-speaking",
        "production-writing",
        "pronunciation-segmental",
        "pronunciation-prosody",
        "grammar-controlled",
        "grammar-spontaneous",
        "pragmatic-use",
        "interaction",
        "retention"
      ]
    },
    "masteryState": {
      "enum": ["unseen", "introduced", "supported", "independent", "flexible", "retained"]
    },
    "prerequisiteStrength": {
      "enum": ["hard", "helpful"]
    },
    "prerequisiteRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "dimension", "required_state", "strength"],
      "properties": {
        "target": { "$ref": "#/$defs/contentId" },
        "dimension": { "$ref": "#/$defs/masteryDimension" },
        "required_state": { "$ref": "#/$defs/masteryState" },
        "strength": { "$ref": "#/$defs/prerequisiteStrength" },
        "migrated_from": {
          "type": "string",
          "description": "Set by the 0.1->0.2 migration; flags records whose dimension/state defaults require human review."
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method"],
      "properties": {
        "method": {
          "enum": ["human", "ai-assisted", "imported", "generated-validated"]
        },
        "tool": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "date": { "$ref": "#/$defs/date" },
        "notes": { "type": "string" }
      }
    },
    "reviewRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_id"],
      "properties": {
        "record_id": { "$ref": "#/$defs/contentId" },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "supportLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "featureMode": {
      "enum": ["teach", "assess-automatic", "assess-guided", "reference-only"]
    }
  }
}
