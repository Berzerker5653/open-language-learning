{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlanguage.invalid/schemas/v0.2/goal.schema.json",
  "title": "Communicative Goal (0.2)",
  "description": "Prerequisites are versioned records scoped by dimension and required state; bare IDs are invalid in 0.2 (docs/03 §7 Layer C).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "description",
    "band",
    "modalities",
    "prerequisites",
    "required_concepts",
    "assessment_ids",
    "transfer_required",
    "sources",
    "review_status"
  ],
  "properties": {
    "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
    "description": { "type": "string", "minLength": 1 },
    "band": { "enum": ["on-ramp", "A1", "A2", "B1", "B2", "C1", "C2"] },
    "framework_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "contexts": {
      "type": "array",
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
      "uniqueItems": true
    },
    "modalities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/modality" }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/prerequisiteRecord" }
    },
    "required_concepts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
    },
    "assessment_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
    },
    "transfer_required": { "type": "boolean" },
    "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "review_status": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/reviewStatus" },
    "generation": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/generation" },
    "review_records": {
      "type": "array",
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/reviewRef" }
    }
  }
}
