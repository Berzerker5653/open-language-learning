{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlanguage.invalid/schemas/v0.2/lexicon-entry.schema.json",
  "title": "Lexical entry / expression (0.2)",
  "description": "One JSONL line per entry. Covers vocabulary.jsonl and expressions.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status", "forms", "glosses", "sources"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["word", "phrase"],
      "default": "word",
      "description": "Expression kind. Absent means word. Phrase entries may declare slots for display-only slot highlighting."
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "description": "Display-only slot structure for phrase entries. Each slot's text must occur verbatim in the primary surface form; the engine drops non-verbatim slots rather than guessing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "alternatives": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
    "status": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/reviewStatus" },
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "script": { "type": "string", "minLength": 1 },
          "is_primary": { "type": "boolean", "default": false }
        }
      }
    },
    "readings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "script": { "type": "string", "minLength": 1 },
          "transliteration_system": { "type": "string", "minLength": 1 }
        }
      }
    },
    "temporary_romanization": {
      "type": "string",
      "description": "Deprecated 0.1 field kept for migration; new packs use readings with transliteration_system."
    },
    "surface": { "type": "string", "description": "Deprecated 0.1 field kept for migration." },
    "reading": { "type": "string", "description": "Deprecated 0.1 field kept for migration." },
    "glosses": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/localeTag" },
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    },
    "part_of_speech": { "type": "string", "minLength": 1 },
    "gender": {
      "type": "string",
      "enum": ["masculine", "feminine", "neuter", "common"],
      "description": "Grammatical gender for gendered languages (e.g. Russian nouns). Derived values must name their source in notes; human review required before verified status."
    },
    "registers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "semantic_tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "band": {
      "enum": ["on-ramp", "A1", "A2", "B1", "B2", "C1", "C2"],
      "description": "Optional framework band this entry aligns to, using the same band vocabulary as curriculum goals (goal.schema.json). Reference alignment only: it is never a certification, JLPT pass, or completion claim (docs/18). Set only with evidence (goal linkage or corpus/common-word frequency evidence) and human review before verified status."
    },
    "framework_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "description": "Optional framework alignment references (e.g. \"jf-standard:onramp\"), mirroring goal framework_refs. References a framework as alignment vocabulary only; never asserts certification."
    },
    "prerequisite_orthography": {
      "type": "array",
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
    },
    "example_refs": {
      "type": "array",
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
    },
    "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "notes": { "type": "string" },
    "generation": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/generation" },
    "review_records": {
      "type": "array",
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/reviewRef" }
    }
  }
}
