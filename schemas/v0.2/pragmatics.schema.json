{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlanguage.invalid/schemas/v0.2/pragmatics.schema.json",
  "title": "Pragmatics notes (0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registers", "situations"],
  "properties": {
    "schema_version": { "const": "0.2" },
    "registers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "formality": { "type": "integer", "minimum": 0, "maximum": 5 }
        }
      }
    },
    "situations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "typical_registers": {
            "type": "array",
            "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
