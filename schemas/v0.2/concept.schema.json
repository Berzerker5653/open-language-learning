{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlanguage.invalid/schemas/v0.2/concept.schema.json",
  "title": "Grammar concept (0.2)",
  "description": "One JSONL line per concept. Grammar dependencies live in grammar/dependencies.yaml (validated by PACK-002).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "category", "status", "sources"],
  "properties": {
    "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
    "name": { "type": "string", "minLength": 1 },
    "category": { "enum": ["morphology", "syntax", "semantics", "pragmatics", "orthography", "phonology"] },
    "status": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/reviewStatus" },
    "definition": { "type": "string" },
    "form_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "usage_rules": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "typical_errors": {
      "type": "object",
      "propertyNames": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/localeTag" },
      "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 } }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "gloss": { "type": "string", "minLength": 1 },
          "translation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "generation": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/generation" },
    "review_records": {
      "type": "array",
      "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/reviewRef" }
    }
  }
}
