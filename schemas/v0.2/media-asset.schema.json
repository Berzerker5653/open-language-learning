{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlanguage.invalid/schemas/v0.2/media-asset.schema.json",
  "title": "Pack media asset record (0.2)",
  "description": "One JSONL line per audio file shipped under `media/` (`media/manifest.jsonl`). Provenance is declared, never inferred from a file's presence: synthesized audio must not be presented as a licensed recording. A `model-output` asset names its synthesizer chain so a release build can regenerate byte-identical media instead of storing binaries in version control (ADR-0016).",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "file", "sha256", "bytes", "sample_rate", "channels", "provenance"],
  "properties": {
    "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
    "file": { "type": "string", "pattern": "^media/[A-Za-z0-9._/-]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bytes": { "type": "integer", "minimum": 1 },
    "sample_rate": { "type": "integer", "minimum": 8000 },
    "channels": { "type": "integer", "minimum": 1, "maximum": 2 },
    "seconds": { "type": "number", "exclusiveMinimum": 0 },
    "provenance": { "enum": ["model-output", "licensed-recording"] },
    "synthesizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "model", "voice"],
      "properties": {
        "runtime": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "model_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "voice": { "type": "string", "minLength": 1 },
        "speed": { "type": "number", "minimum": 0.1, "maximum": 4 }
      }
    },
    "text": { "type": "string", "minLength": 1, "description": "The exact string fed to the synthesizer: the item's declared reading when it declares one, only the written form when it does not. The validator enforces this tie (media_text_not_declared_reading, K-65) and the notes name the field this string came from." },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "provenance": { "const": "model-output" } } },
      "then": { "required": ["synthesizer", "generated", "text"] }
    }
  ]
}
