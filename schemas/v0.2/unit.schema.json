{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlanguage.invalid/schemas/v0.2/unit.schema.json",
  "title": "Curriculum unit (0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "goal_id", "title", "activities"],
  "properties": {
    "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
    "goal_id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "estimated_minutes": { "type": "integer", "minimum": 1 },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "modality", "support_level"],
        "properties": {
          "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
          "type": { "type": "string", "minLength": 1 },
          "modality": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/modality" },
          "support_level": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/supportLevel" },
          "scenario_id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
          "content_refs": {
            "type": "array",
            "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
          },
          "concept_refs": {
            "type": "array",
            "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
          }
        }
      }
    },
    "generation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_vocab", "new_item_budget", "validation_method"],
      "description": "K-21: machine-checkable dynamic-content constraints (docs/03 §12). When present, every activity content_ref/concept_ref must be covered by allowed_vocab/allowed_grammar, and referenced ids must exist in the pack.",
      "properties": {
        "allowed_vocab": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
        },
        "allowed_grammar": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
        },
        "new_item_budget": { "type": "integer", "minimum": 0 },
        "register": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
        },
        "expected_interpretations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "prohibited_ambiguity": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "target_proficiency": { "enum": ["on-ramp", "A1", "A2", "B1", "B2", "C1", "C2"] },
        "validation_method": { "enum": ["exact-match", "choice", "human-review", "model-validated"] }
      }
    }
  }
}
