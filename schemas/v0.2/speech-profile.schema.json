{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlanguage.invalid/schemas/v0.2/speech-profile.schema.json",
  "title": "Speech profile (0.2)",
  "description": "Provider/model binding plus calibration state. A null threshold means the feature is unavailable for automatic assessment; teach/reference-only features may omit calibration.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "provider", "model", "target_locale", "features"],
  "properties": {
    "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "target_locale": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/localeTag" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "mode"],
        "properties": {
          "feature_id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
          "mode": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/featureMode" },
          "calibration": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["dataset_id", "date", "threshold"],
                "properties": {
                  "dataset_id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
                  "date": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/date" },
                  "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
                  "sample_count": { "type": "integer", "minimum": 1 }
                }
              }
            ]
          }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
