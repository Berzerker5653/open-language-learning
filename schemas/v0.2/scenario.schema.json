{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openlanguage.invalid/schemas/v0.2/scenario.schema.json",
  "title": "Scenario graph (0.2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "goal_id", "title", "nodes", "support_ladder", "transfer_variants_required"],
  "properties": {
    "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
    "goal_id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
    "title": { "type": "string", "minLength": 1 },
    "situation": { "type": "string" },
    "register": { "type": "string" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "prompt"],
        "properties": {
          "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
          "prompt": { "type": "string", "minLength": 1 },
          "expected_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "next": {
            "type": "array",
            "items": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
          },
          "recovery": {
            "type": "array",
            "description": "Recovery branches offered when the learner's attempt does not satisfy the node (miscommunication, repair). Data-driven; the runtime never branches on language-specific rules (SCENARIO-001).",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "prompt"],
              "properties": {
                "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
                "prompt": { "type": "string", "minLength": 1 },
                "expected_actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
                "to": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" }
              }
            }
          }
        }
      }
    },
    "support_ladder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["support_level", "description"],
        "properties": {
          "support_level": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/supportLevel" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "transfer_variants_required": { "type": "integer", "minimum": 0 },
    "transfer_variants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": { "$ref": "https://openlanguage.invalid/schemas/v0.2/common.schema.json#/$defs/contentId" },
          "description": { "type": "string", "minLength": 1 },
          "changed_variable": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
